# ═══════════════════════════════════════════════════════
#  YouTubeSEO Sniper  —  .env.example
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────
# NVIDIA NIM API key (free tier available at build.nvidia.com)
NVIDIA_NIM_API_KEY=

# ── OPTIONAL (enables YouTube API trend data) ────────────
# YouTube Data API v3 key — free 10,000 units/day
# Get from: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=
